# URL pública do site (https em produção). Usada nos retornos e no webhook do Mercado Pago.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API). A service role NUNCA vai para o navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Suas integrações > Credenciais). Use as de teste primeiro.
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integrações > Webhooks)
MP_WEBHOOK_SECRET=

# Enquanto for só pré-venda, deixe false: não calcula nem cobra frete (Melhor Envio fica desligado).
# Quando for enviar pelos Correios, troque para true e preencha as variáveis do Melhor Envio abaixo.
NEXT_PUBLIC_SHIPPING_ENABLED=false

# Melhor Envio (só se NEXT_PUBLIC_SHIPPING_ENABLED=true). Token em Configurações > Tokens.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=true
MELHOR_ENVIO_EMAIL=seu-email@dominio.com
# CEP de onde você envia (só números)
STORE_ORIGIN_CEP=
# Opcional: frete grátis a partir de X centavos (ex.: 29900 = R$ 299). Deixe vazio para desligar.
FREE_SHIPPING_MIN_CENTS=

# Painel /admin
ADMIN_PASSWORD=
# Texto aleatório longo (32+ caracteres) para assinar o login do painel
SESSION_SECRET=
